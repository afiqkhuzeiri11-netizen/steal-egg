-- 3. LOGIKA CACHE TELUR & PEMINDAIAN ANTI-LAG
-- ==========================================
local function getPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function isValidEgg(obj)
    if not obj or not obj.Parent then return false end
    local char = LocalPlayer.Character
    if char and obj:IsDescendantOf(char) then return false end
    if obj:IsA("BasePart") or obj:IsA("Model") then
        local nameLower = string.lower(obj.Name)
        if string.find(nameLower, Config.Keyword, 1, true) then
            return getPart(obj) ~= nil
        end
    end
    return false
end

local function rebuildCache()
    table.clear(EggCache)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isValidEgg(obj) then
            table.insert(EggCache, obj)
        end
    end
    StatusText.Text = "Telur Terdeteksi: " .. tostring(#EggCache) .. " objek"
end

InputBox.FocusLost:Connect(function()
    local txt = string.lower(InputBox.Text):gsub("^%s*(.-)%s*$", "%1")
    Config.Keyword = (txt ~= "" and txt) or "egg"
    rebuildCache()
end)

Workspace.DescendantAdded:Connect(function(obj)
    task.wait(0.1)
    if isValidEgg(obj) then
        table.insert(EggCache, obj)
