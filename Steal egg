-- 4. EKSEKUSI AUTO FARM, NOCLIP & INTERAKSI
-- ==========================================
-- Noclip & Speed Loop
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    if Config.AutoFarm and Config.Noclip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    if Config.SpeedBoost then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= Config.WalkSpeed then
            hum.WalkSpeed = Config.WalkSpeed
        end
    end
end)

local function collectEgg(egg, rootPart)
    local part = getPart(egg)
    if not part then return end

    -- 1. Sentuhan Fisik (TouchInterest)
    if firetouchinterest then
        pcall(function()
            firetouchinterest(rootPart, part, 0)
            task.wait(0.03)
            firetouchinterest(rootPart, part, 1)
        end)
    end

    -- 2. Tombol Interaksi (ProximityPrompt)
    local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true) or (egg.Parent and egg.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
    if prompt and fireproximityprompt then
        pcall(function() fireproximityprompt(prompt) end)
    end

    -- 3. Klik Objek (ClickDetector)
    local click = egg:FindFirstChildWhichIsA("ClickDetector", true)
    if click and fireclickdetector then
        pcall(function() fireclickdetector(click) end)
    end
end

-- Loop Auto Farm Utama
task.spawn(function()
    rebuildCache()
    while task.wait(0.15) do
        if Config.AutoFarm then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum or hum.Health <= 0 then return end

                local nearestEgg, nearestPart, minDist = nil, nil, math.huge

                for i = #EggCache, 1, -1 do
                    local egg = EggCache[i]
                    local part = isValidEgg(egg) and getPart(egg)
                    if part and part.Parent then
                        local dist = (root.Position - part.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearestEgg = egg
                            nearestPart = part
                        end
                    else
                        table.remove(EggCache, i)
                    end
                end

                if nearestEgg and nearestPart then
                    StatusText.Text = "Mengambil: " .. nearestEgg.Name .. " (" .. math.floor(minDist) .. "m)"
                    local targetCF = nearestPart.CFrame + Vector3.new(0, 1.5, 0)

                    if Config.UseTween and minDist > 8 then
                        local duration = math.clamp(minDist / Config.TweenSpeed, 0.08, 3.5)
                        local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCF})
                        tw:Play()
                        tw.Completed:Wait()
                    else
                        root.CFrame = targetCF
                    end

                    collectEgg(nearestEgg, root)
                else
                    StatusText.Text = "Mencari telur baru di map..."
                    rebuildCache()
                    task.wait(1)
                end
            end)
        end
    end
end)

